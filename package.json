{
  "name": "@local901/js-ui",
  "version": "0.0.2",
  "description": "UI library for React",
  "type": "module",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "start": "vite",
    "test": "vitest run",
    "test:cover": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/local901/js-ui.git"
  },
  "keywords": [
    "react",
    "ui",
    "jsx"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/local901/js-ui/issues"
  },
  "homepage": "https://github.com/local901/js-ui#readme",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.jsx"
    },
    "./elements": {
      "types": "./elements/index.d.ts",
      "import": "./elements/index.jsx"
    },
    "./guards": {
      "types": "./guards/index.d.ts",
      "import": "./guards/index.jsx"
    },
    "./hooks": {
      "types": "./hooks/index.d.ts",
      "import": "./hooks/index.jsx"
    },
    "./input": {
      "types": "./input/index.d.ts",
      "import": "./input/index.jsx"
    },
    "./layout": {
      "types": "./layout/index.d.ts",
      "import": "./layout/index.jsx"
    },
    "./overlay": {
      "types": "./overlay/index.d.ts",
      "import": "./overlay/index.jsx"
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  }
}
