{
  "name": "@local901/js-ui",
  "version": "0.0.3",
  "description": "UI library for React",
  "type": "module",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "start": "vite",
    "test": "vitest run",
    "test:cover": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/local901/js-ui.git"
  },
  "keywords": [
    "react",
    "ui",
    "jsx"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/local901/js-ui/issues"
  },
  "homepage": "https://github.com/local901/js-ui#readme",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.jsx"
    },
    "./jsx/*": {
      "types": "./jsx/*.d.ts",
      "import": "./jsx/*.jsx"
    },
    "./hooks/*": {
      "types": "./hooks/*.d.ts",
      "import": "./hooks/*.js"
    },
    "./theme/*": {
      "types": "./theme/*.d.ts",
      "import": "./theme/*.js"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  }
}
